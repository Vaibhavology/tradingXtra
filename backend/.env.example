# ── Database (Supabase PostgreSQL) ──
# Production: Use the "Transaction Pooler" URL (port 6543) from Supabase Dashboard > Settings > Database
# Local dev / migrations: Use the "Direct" URL (port 5432) instead
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
ENVIRONMENT=production

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:3000,https://tradingxtra.vercel.app

# ── AI Integration ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── Data Source ──
DATA_SOURCE=live

# ── YouTube Channel (InvestSmart) ──
YOUTUBE_CHANNEL_ID=UCFlpGKkFc9KW6aWbDdx3oVQ
